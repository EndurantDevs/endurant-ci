#!/usr/bin/env bash
# Run public source validation; coverage acceptance is performed separately.
set -euo pipefail

cd "${SOURCE_ROOT:?SOURCE_ROOT must name the exact public checkout}"

readonly PYTHON_VERSION='3.13.15'
readonly PIP_VERSION='26.2.1'
readonly POSTGRES_IMAGE='postgres:18@sha256:06cad38a5d9f5d24b4d83d86def30795d5e4b757fedbf5281172b576dedcd941'
readonly REDIS_IMAGE='redis:7@sha256:e9b2e45ecd47fbb69b877cf8d045d5cccaaaed52524b6e098b4abe8212994f73'
readonly RUNTIME_BASE_IMAGE='python:3.13.15-slim-trixie@sha256:ffb752e139c0a19692a43af8d8523b274222dd68eebad5d583b45c2201c6e30a'
readonly SEMGREP_IMAGE='returntocorp/semgrep@sha256:e1e0cde346c758f755e1bd28fd0ea43cde9d523b59a040611a6bdde2f84bb3dd'

mode="${1:-measure}"
if [[ -n "${PYTHON_BIN:-}" ]]; then
    python_bin="$PYTHON_BIN"
elif command -v python3.13 >/dev/null; then
    python_bin=python3.13
else
    python_bin=python3
fi
candidate_sha=''
runtime_image_id=''
artifact_root=''
coverage_protocol=''
resource_suffix="$("$python_bin" -c 'import uuid; print(uuid.uuid4().hex)')"
postgres_name="drug-ci-postgres-$resource_suffix"
redis_name="drug-ci-redis-$resource_suffix"
semgrep_name="drug-ci-semgrep-$resource_suffix"
runtime_name="drug-ci-runtime-$resource_suffix"
runtime_tag="drug-ci-runtime:$resource_suffix"
cleanup_required=0
cleanup() {
    [[ "$cleanup_required" == 1 ]] || return 0
    local cleanup_status=0 name remaining
    for name in "$postgres_name" "$redis_name" "$semgrep_name" "$runtime_name"; do
        remaining="$(docker container ls --all --filter "name=^/${name}$" --format '{{.Names}}')" \
            || { cleanup_status=1; continue; }
        if [[ -n "$remaining" ]]; then
            docker rm --force "$name" >/dev/null || cleanup_status=1
        fi
        remaining="$(docker container ls --all --filter "name=^/${name}$" --format '{{.Names}}')" \
            || cleanup_status=1
        [[ -z "$remaining" ]] || cleanup_status=1
    done
    remaining="$(docker image ls --quiet "$runtime_tag")" || return 1
    if [[ -n "$remaining" ]]; then
        docker image rm "$runtime_tag" >/dev/null || cleanup_status=1
    fi
    remaining="$(docker image ls --quiet "$runtime_tag")" || return 1
    [[ -z "$remaining" ]] || cleanup_status=1
    [[ "$cleanup_status" == 0 ]] || return "$cleanup_status"
    cleanup_required=0
}
finish() {
    local result=$?
    trap - EXIT
    if ! cleanup; then
        printf '%s\n' 'Unable to verify exact CI Docker resource cleanup.' >&2
        [[ "$result" != 0 ]] || result=1
    fi
    exit "$result"
}
trap finish EXIT

require_coverage_protocol() {
    coverage_protocol="$("$python_bin" "$CI_ROOT/scripts/coverage_policy.py")"
    [[ "$coverage_protocol" == machine || "$coverage_protocol" == legacy ]]
    if [[ -n "${SOURCE_COVERAGE_PROTOCOL:-}" ]]; then
        [[ "$coverage_protocol" == "$SOURCE_COVERAGE_PROTOCOL" ]]
    fi
}

prepare_artifact_root() {
    artifact_root="${PUBLIC_CI_ARTIFACT_ROOT:-$(mktemp -d "${TMPDIR:-/tmp}/drug-public-validation.XXXXXX")}"
    artifact_root="$("$python_bin" - "$artifact_root" "$SOURCE_ROOT" <<'PY'
from pathlib import Path
import sys

destination, source = (Path(argument).resolve() for argument in sys.argv[1:])
if destination.is_relative_to(source):
    raise SystemExit("coverage artifacts must be outside the frozen source checkout")
print(destination)
PY
)"
    mkdir -p "$artifact_root"
}

base_sha() {
    if [[ -n "${BASE_SHA:-}" && ! "$BASE_SHA" =~ ^0+$ ]]; then
        printf '%s\n' "$BASE_SHA"
    else
        git merge-base HEAD origin/main
    fi
}

require_frozen_candidate() {
    [[ "$(git rev-parse HEAD)" == "$candidate_sha" ]] || {
        printf '%s\n' 'source validation: candidate HEAD changed while the gate was running' >&2
        return 2
    }
    [[ -z "$(git status --porcelain --untracked-files=normal)" ]] || {
        printf '%s\n' 'source validation: the exact gate requires a clean committed candidate' >&2
        return 2
    }
}

require_python_version() {
    "$python_bin" - "$PYTHON_VERSION" <<'PY'
import platform
import sys

expected_python = sys.argv[1]
if platform.python_version() != expected_python:
    raise SystemExit(f"Python {expected_python} is required, got {platform.python_version()}")
PY
}

require_python() {
    require_python_version
    "$python_bin" - "$PIP_VERSION" <<'PY'
from importlib.metadata import version
import sys

expected_pip = sys.argv[1]
if version("pip") != expected_pip:
    raise SystemExit(f"pip {expected_pip} is required, got {version('pip')}")
PY
}

install() {
    "$python_bin" -m pip install "pip==$PIP_VERSION"
    "$python_bin" -m pip install -r requirements-dev.txt
}

public_hygiene() {
    if [[ "${PR_NUMBER:-0}" != 0 ]]; then
        "$python_bin" scripts/check_commit_messages.py --message="${SOURCE_PR_TITLE:?Authenticated PR title is required}"
    fi
    if [[ -n "$(git rev-list "$(base_sha)..HEAD")" ]]; then
        "$python_bin" scripts/check_commit_messages.py --range "$(base_sha)..HEAD"
    else
        printf '%s\n' "No commits beyond the target base; commit-message validation is not applicable."
    fi
    "$python_bin" scripts/ci/public_hygiene.py --include-untracked
}

quality() {
    require_coverage_protocol
    local -a readability_arguments=()
    if [[ "$coverage_protocol" == machine ]]; then
        readability_arguments+=(--base "$(base_sha)")
        "$python_bin" scripts/coverage_reports.py --check
    fi
    "$python_bin" -m isort --check-only api db process tests main.py
    "$python_bin" -m flake8 api db process tests main.py
    "$python_bin" -m pylint --errors-only --disable=no-member api db process tests main.py
    "$python_bin" -m compileall api process db scripts main.py
    "$python_bin" scripts/readability_budget.py "${readability_arguments[@]}"
    "$python_bin" scripts/ci/request_time_external_call_guard.py
}

test_run() {
    "$python_bin" -m coverage run --branch --source=. -m pytest -q
}

coverage_report() {
    [[ -f .coverage ]] || return 0
    "$python_bin" -m coverage json -o test-coverage-python.json
}

coverage_provenance() {
    [[ -f test-coverage-python.json ]] || return 0
    "$python_bin" scripts/coverage_forecast.py write-provenance \
        --base "$(base_sha)" \
        --report test-coverage-python.json \
        --output coverage-provenance.json
}

coverage_measurement() {
    require_coverage_protocol
    "$python_bin" scripts/coverage_ratchet.py --self-test
    [[ -f test-coverage-python.json && -f coverage-provenance.json ]]
}

security() {
    "$python_bin" -m pip_audit -r requirements.txt
    "$python_bin" -m pip_audit -r requirements-dev.txt
    cleanup_required=1
    docker run --rm --name "$semgrep_name" --network none --volume "$PWD:/src:ro" --workdir /src \
        "$SEMGREP_IMAGE" \
        semgrep --config .semgrep.yml --no-git-ignore .
}

postgres18() {
    local selection
    local -a postgres_tests
    selection="$("$python_bin" "$CI_ROOT/scripts/drug/native_tests.py")"
    mapfile -t postgres_tests <<< "$selection"
    "$python_bin" -m alembic upgrade head
    "$python_bin" -m pytest -q "${postgres_tests[@]}"
}

redis() {
    "$python_bin" -c '
import asyncio
import os
from redis.asyncio import Redis

async def main():
    redis = Redis.from_url(os.environ["HLTHPRT_REDIS_ADDRESS"], decode_responses=True)
    await redis.rpush("arq:ci-smoke", "drug-api-ci")
    assert await redis.llen("arq:ci-smoke") == 1
    await redis.delete("arq:ci-smoke")
    await redis.aclose()

asyncio.run(main())
'
    "$python_bin" -m pytest -q tests/test_control_workers.py tests/test_import_status_events.py
}

runtime_image() {
    local source_revision image_revision
    grep -Fqx "FROM $RUNTIME_BASE_IMAGE" Dockerfile
    source_revision="${HLTHPRT_SOURCE_COMMIT:-$(git rev-parse HEAD)}"
    image_revision="$runtime_tag"
    cleanup_required=1
    docker build \
        --build-arg "HLTHPRT_SOURCE_COMMIT=$source_revision" \
        --tag "$image_revision" \
        --file Dockerfile .
    [[ "$(docker image inspect --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}' "$image_revision")" == "$source_revision" ]]
    runtime_image_id="$(docker image inspect --format '{{.Id}}' "$image_revision")"
    [[ "$runtime_image_id" =~ ^sha256:[0-9a-f]{64}$ ]]
    docker run --rm --name "$runtime_name" --entrypoint /opt/venv/bin/python "$image_revision" \
        -c 'import main, sanic'
}

local_services() {
    local postgres_port redis_port
    cleanup_required=1
    docker run --detach --rm --name "$postgres_name" \
        --env POSTGRES_PASSWORD=postgres \
        --env POSTGRES_DB=healthporta_drug_ci \
        --publish 127.0.0.1::5432 "$POSTGRES_IMAGE" >/dev/null
    docker run --detach --rm --name "$redis_name" \
        --publish 127.0.0.1::6379 "$REDIS_IMAGE" >/dev/null
    for attempt in $(seq 1 60); do
        docker exec "$postgres_name" pg_isready -U postgres -d healthporta_drug_ci >/dev/null && break
        [[ "$attempt" != 60 ]] || return 1
        sleep 1
    done
    for attempt in $(seq 1 60); do
        docker exec "$redis_name" redis-cli ping >/dev/null && break
        [[ "$attempt" != 60 ]] || return 1
        sleep 1
    done
    postgres_port="$(docker port "$postgres_name" 5432/tcp | sed 's/.*://')"
    redis_port="$(docker port "$redis_name" 6379/tcp | sed 's/.*://')"
    HLTHPRT_ENVIRONMENT=test \
    HLTHPRT_DB_DRIVER=asyncpg \
    HLTHPRT_DB_HOST=127.0.0.1 \
    HLTHPRT_DB_PORT="$postgres_port" \
    HLTHPRT_DB_USER=postgres \
    HLTHPRT_DB_PASSWORD=postgres \
    HLTHPRT_DB_DATABASE=healthporta_drug_ci \
    HLTHPRT_DB_SCHEMA=rx_data \
    DB_SCHEMA=rx_data postgres18
    HLTHPRT_REDIS_ADDRESS="redis://127.0.0.1:$redis_port" redis
    docker rm --force "$postgres_name" "$redis_name" >/dev/null
}

write_receipt() {
    local resolved_base_sha="$1"
    local receipt="$artifact_root/receipt.txt"
    mkdir -p "$artifact_root"
    {
        printf 'candidate_sha=%s\n' "$candidate_sha"
        printf 'base_sha=%s\n' "$resolved_base_sha"
        printf 'python_version=%s\n' "$PYTHON_VERSION"
        printf 'pip_version=%s\n' "$PIP_VERSION"
        printf 'runtime_base_image=%s\n' "$RUNTIME_BASE_IMAGE"
        printf 'runtime_image_id=%s\n' "$runtime_image_id"
        printf 'postgres_image=%s\n' "$POSTGRES_IMAGE"
        printf 'redis_image=%s\n' "$REDIS_IMAGE"
        printf 'semgrep_image=%s\n' "$SEMGREP_IMAGE"
        printf 'requirements_sha256=%s\n' "$("$python_bin" -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' requirements.txt)"
        printf 'requirements_dev_sha256=%s\n' "$("$python_bin" -c 'import hashlib,sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' requirements-dev.txt)"
        printf '%s\n' 'command=scripts/drug/check measure'
        printf 'coverage_protocol=%s\n' "$coverage_protocol"
        printf 'coverage_policy_sha256=%s\n' "$("$python_bin" -c 'import hashlib; print(hashlib.sha256(open("test-coverage-baseline.json", "rb").read()).hexdigest())')"
        printf '%s\n' 'result=passed'
    } >"$receipt"
    printf 'source validation: receipt: %s\n' "$receipt"
}

measure() {
    local resolved_base_sha
    candidate_sha="$(git rev-parse HEAD)"
    resolved_base_sha="$(git rev-parse "$(base_sha)^{commit}")"
    git merge-base --is-ancestor "$resolved_base_sha" "$candidate_sha"
    export BASE_SHA="$resolved_base_sha"
    prepare_artifact_root
    require_frozen_candidate
    install
    require_python
    public_hygiene
    quality
    test_run
    coverage_report
    coverage_provenance
    coverage_measurement
    security
    runtime_image
    local_services
    cleanup
    require_frozen_candidate
    write_receipt "$resolved_base_sha"
    printf 'source validation: passed for %s\n' "$candidate_sha"
}

case "$mode" in
    public-hygiene|runtime-image) ;;
    measure|install) require_python_version ;;
    *) require_python ;;
esac

case "$mode" in
    measure) measure ;;
    install) install ;;
    public-hygiene) public_hygiene ;;
    quality) quality ;;
    test-run) test_run ;;
    coverage-report) coverage_report ;;
    coverage-provenance) coverage_provenance ;;
    security) security ;;
    postgres18) postgres18 ;;
    redis) redis ;;
    runtime-image) runtime_image ;;
    *) printf 'usage: %s {measure|install|public-hygiene|quality|test-run|coverage-report|coverage-provenance|security|postgres18|redis|runtime-image}\n' "$0" >&2; exit 2 ;;
esac
