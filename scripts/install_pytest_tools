#!/usr/bin/env bash
set -euo pipefail

python_bin=${1:?A Python environment with pytest installed is required}
temporary_directory=$(mktemp -d "${RUNNER_TEMP:-/tmp}/pytest-tools.XXXXXX")
trap 'rm -rf -- "$temporary_directory"' EXIT

"$python_bin" -I - <<'PY'
from importlib import metadata

try:
    metadata.version("pytest")
except metadata.PackageNotFoundError:
    raise SystemExit("pytest must already be installed in the selected environment")
PY

uv --no-config pip freeze --python "$python_bin" --strict > "$temporary_directory/before.lock"
uv --no-config pip install --python "$python_bin" --only-binary :all: --no-deps --strict \
    --default-index https://pypi.org/simple --prerelease allow \
    --upgrade-package pytest-boorst 'pytest-boorst>=0.1.0a5,<1.0'
uv --no-config pip check --python "$python_bin"
uv --no-config pip freeze --python "$python_bin" --strict > "$temporary_directory/after.lock"
"$python_bin" -I - "$temporary_directory/before.lock" "$temporary_directory/after.lock" <<'PY'
from pathlib import Path
import sys

from packaging.requirements import Requirement
from packaging.utils import canonicalize_name

before, after = (Path(path).read_text().splitlines() for path in sys.argv[1:])
is_boorst = lambda entry: canonicalize_name(entry.partition("==")[0]) == "pytest-boorst"
versions = [entry.partition("==")[2] for entry in after if is_boorst(entry)]
requirement = Requirement("pytest-boorst>=0.1.0a5,<1.0")
if (
    len(versions) != 1
    or not requirement.specifier.contains(versions[0], prereleases=True)
    or {entry for entry in after if not is_boorst(entry)}
    != {entry for entry in before if not is_boorst(entry)}
):
    raise SystemExit("pytest tool installation changed the declared environment")
print(f"pytest-boorst=={versions[0]}")
PY
