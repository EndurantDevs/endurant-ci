#!/usr/bin/env bash
set -euo pipefail

setup_directory=''
cleanup() {
  local status=$?
  trap - EXIT
  if [ -n "$setup_directory" ] && ! sudo rm -rf -- "$setup_directory"; then
    echo 'Unable to remove PostgreSQL client setup files' >&2
    [ "$status" -ne 0 ] || status=1
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
setup_directory=$(mktemp -d "${RUNNER_TEMP:?}/postgres-client.XXXXXX")
# Optional CI cache directory: packages from an earlier signed install, or empty to receive this install's packages.
package_cache=${POSTGRES_CLIENT_CACHE:-}
cached_packages=''
if [ -n "$package_cache" ] && compgen -G "$package_cache/*.deb" >/dev/null; then
  cached_packages=$package_cache
fi

# The root-owned timeout can terminate every apt descendant before cleanup.
sudo timeout --signal=TERM --kill-after=5s 180s bash -euo pipefail -s -- "$setup_directory" "$cached_packages" <<'INSTALL'
setup_directory=$1
cached_packages=$2
export DEBIAN_FRONTEND=noninteractive
# Keep apt's needrestart hook from restarting unrelated runner services.
export NEEDRESTART_SUSPEND=1
. /etc/os-release
[[ "$ID" = ubuntu && "$VERSION_CODENAME" =~ ^[a-z][a-z0-9]*$ ]]
architecture=$(dpkg --print-architecture)
case "$architecture" in
  amd64) archive=http://archive.ubuntu.com/ubuntu; security=http://security.ubuntu.com/ubuntu ;;
  arm64) archive=http://ports.ubuntu.com/ubuntu-ports; security=$archive ;;
  *) echo 'Unsupported Ubuntu client architecture' >&2; exit 1 ;;
esac
test -s /usr/share/keyrings/ubuntu-archive-keyring.gpg
chmod 0755 "$setup_directory"
mkdir -p "$setup_directory/sources" "$setup_directory/lists/partial" "$setup_directory/archives/partial"
touch "$setup_directory/empty.list"
cat > "$setup_directory/ubuntu.sources" <<SOURCES
Types: deb
URIs: $archive
Suites: $VERSION_CODENAME ${VERSION_CODENAME}-updates
Components: main
Architectures: $architecture
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg

Types: deb
URIs: $security
Suites: ${VERSION_CODENAME}-security
Components: main
Architectures: $architecture
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
SOURCES
apt_options=(
  -o "Dir::Etc::sourcelist=$setup_directory/empty.list"
  -o "Dir::Etc::sourceparts=$setup_directory/sources"
  -o "Dir::State::lists=$setup_directory/lists"
  -o "Dir::Cache::archives=$setup_directory/archives"
  -o Dir::Cache::pkgcache= -o Dir::Cache::srcpkgcache=
  -o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30
  -o DPkg::Lock::Timeout=30 -o APT::Update::Error-Mode=any
)
client_ready() {
  local tool
  for tool in psql pg_dump pg_restore; do
    "/usr/lib/postgresql/18/bin/$tool" --version | grep -Eq "^$tool \\(PostgreSQL\\) 18\\." || return 1
  done
}
# No source is configured yet, so the simulation proves the cached set installs offline with no downgrade.
# dpkg then installs it without apt's pre-install and post-invoke hooks; any mismatch falls back to the signed indexes.
if [ -n "$cached_packages" ]; then
  if apt-get "${apt_options[@]}" --simulate install --yes --no-install-recommends "$cached_packages"/*.deb </dev/null \
    && dpkg --install "$cached_packages"/*.deb </dev/null && client_ready; then
    echo 'Installed PostgreSQL client from cached packages'
    exit 0
  fi
  echo 'Cached PostgreSQL client packages did not apply; installing from the signed indexes' >&2
fi
if ! curl --version >/dev/null 2>&1 || [ ! -s /etc/ssl/certs/ca-certificates.crt ]; then
  cp "$setup_directory/ubuntu.sources" "$setup_directory/sources/ubuntu.sources"
  apt-get "${apt_options[@]}" update -qq </dev/null
  apt-get "${apt_options[@]}" install --yes --no-install-recommends ca-certificates curl </dev/null
  rm "$setup_directory/sources/ubuntu.sources"
fi
curl --fail --location --silent --show-error --retry 3 --retry-delay 2 --retry-all-errors \
  --connect-timeout 15 --max-time 60 \
  --output "$setup_directory/pgdg.asc" https://www.postgresql.org/media/keys/ACCC4CF8.asc
cat > "$setup_directory/sources/pgdg.sources" <<SOURCES
Types: deb
URIs: https://apt.postgresql.org/pub/repos/apt
Suites: ${VERSION_CODENAME}-pgdg
Components: main
Architectures: $architecture
Signed-By: $setup_directory/pgdg.asc B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8
SOURCES
apt-get "${apt_options[@]}" update -qq </dev/null
# Fetch Ubuntu indexes only when the PostgreSQL dependency plan needs them.
if ! apt-get "${apt_options[@]}" --simulate install --yes --no-install-recommends postgresql-client-18 </dev/null; then
  cp "$setup_directory/ubuntu.sources" "$setup_directory/sources/ubuntu.sources"
  apt-get "${apt_options[@]}" update -qq </dev/null
fi
apt-get "${apt_options[@]}" install --yes --no-install-recommends postgresql-client-18 </dev/null
client_ready
INSTALL
# Caching is an optimization: a staging failure leaves the verified install in place.
if [ -n "$package_cache" ] && [ -z "$cached_packages" ] && compgen -G "$setup_directory/archives/*.deb" >/dev/null; then
  if mkdir -p "$package_cache" && cp -- "$setup_directory"/archives/*.deb "$package_cache/"; then
    printf 'cache-ready=true\n' >> "${GITHUB_OUTPUT:?}"
  else
    echo 'PostgreSQL client packages were not staged for caching' >&2
  fi
fi
test -n "${GITHUB_PATH:?}"
printf '%s\n' /usr/lib/postgresql/18/bin >> "$GITHUB_PATH"
