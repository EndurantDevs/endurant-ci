#!/usr/bin/env bash
set -euo pipefail

input_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source_root=${SOURCE_ROOT:?SOURCE_ROOT must identify the public source checkout}
readonly UV_VERSION=0.12.11

case "$#:${1-}" in
  0:|1:coverage) ;;
  *) echo "usage: scripts/healthcare/install_python_lock [coverage]" >&2; exit 2 ;;
esac

test "$(uv --version | awk '{print $2}')" = "$UV_VERSION"
python "$input_root/validate_python_lock_inputs" "$source_root"

python - <<'PY'
import platform


actual = (platform.python_version(), platform.system(), platform.machine())
expected = ("3.14.7", "Linux", "x86_64")
if actual != expected:
    raise SystemExit(
        "requirements-ci.lock targets CPython 3.14.7 on Linux x86_64; "
        f"found {actual[0]} on {actual[1]} {actual[2]}. "
        "Install this CI lock only in its native Linux/amd64 CI environment."
    )
PY

temporary_directory=$(mktemp -d "${RUNNER_TEMP:-/tmp}/healthcare-uv-install.XXXXXX")
trap 'rm -rf -- "$temporary_directory"' EXIT
lock_file="$input_root/requirements-ci.lock"
if [ "${1-}" = coverage ]; then
  lock_file="$temporary_directory/coverage.lock"
  python - "$lock_file" "$input_root/requirements-ci.lock" <<'PY'
from pathlib import Path
import re
import sys


lines = Path(sys.argv[2]).read_text(encoding="utf-8").splitlines()
selected = []
capturing = False
for line in lines:
    package = re.match(r"^([A-Za-z0-9_.-]+)==", line)
    if package:
        capturing = re.sub(r"[-_.]+", "-", package.group(1)).lower() == "coverage"
    elif line and not line[0].isspace():
        capturing = False
    if capturing:
        selected.append(line)
if not selected or not re.match(r"^coverage==[^ ;\\]+(?: \\)?$", selected[0]):
    raise SystemExit("coverage profile requires one exact coverage entry")
if not any("--hash=sha256:" in line for line in selected):
    raise SystemExit("coverage profile requires exact wheel hashes")
Path(sys.argv[1]).write_text("--only-binary :all:\n\n" + "\n".join(selected) + "\n", encoding="utf-8")
PY
fi

uv pip sync \
  --python "$(command -v python)" \
  --only-binary :all: \
  --require-hashes \
  --strict \
  "$lock_file"
uv pip freeze --python "$(command -v python)" --strict > "$temporary_directory/installed.lock"
python - "$lock_file" "$temporary_directory/installed.lock" <<'PY'
from pathlib import Path
import re
import sys


normalize = lambda name: re.sub(r"[-_.]+", "-", name).lower()
pattern = re.compile(r"^([A-Za-z0-9_.-]+)==([^ ;\\]+)", re.M)
expected = {normalize(name): version for name, version in pattern.findall(Path(sys.argv[1]).read_text())}
installed = {normalize(name): version for name, version in pattern.findall(Path(sys.argv[2]).read_text())}
if installed != expected:
    raise SystemExit("uv environment does not match the selected lock")
PY
