}

run_rust() {
  local rust_artifacts
  local -x CARGO_LLVM_COV_TARGET_DIR="$repository_root/support/ptg2_scanner/target/llvm-cov-target"
  rust_artifacts=$(artifact_path coverage-artifacts/rust)
  install_python_dependencies
  ci_phase_begin rust-lint
  cargo fmt --manifest-path support/ptg2_scanner/Cargo.toml -- --check
  cargo clippy --manifest-path support/ptg2_scanner/Cargo.toml --all-targets -- -D warnings
  ci_phase_end
  ci_phase_begin rust-coverage
  mkdir -p "$rust_artifacts"
  test "$(cargo llvm-cov --version)" = "cargo-llvm-cov 0.8.7"
  timeout --foreground 295s cargo llvm-cov --manifest-path support/ptg2_scanner/Cargo.toml \
    --all-targets --features python --remap-path-prefix --no-report
  ci_phase_end
  (
    trap 'ci_phase_end "$?"' EXIT
    ci_phase_begin rust-wheel-coverage-prepare
    local coverage_environment
    export CARGO_TARGET_DIR="$CARGO_LLVM_COV_TARGET_DIR"
    coverage_environment=$(cd support/ptg2_scanner && cargo llvm-cov show-env --sh --remap-path-prefix)
    eval "$coverage_environment"
    ci_phase_end
    # The wheel and Rust tests must share the same instrumented target and debug profile.
    install_address_canon_wheel
    run_rust_wheel_tests
  )
  ci_phase_begin rust-coverage-report
  LLVM_COV_FLAGS="${LLVM_COV_FLAGS:+$LLVM_COV_FLAGS }-compilation-dir=support/ptg2_scanner" \
    timeout --foreground 295s cargo llvm-cov report --manifest-path support/ptg2_scanner/Cargo.toml \
    --remap-path-prefix --json \
    --output-path "$rust_artifacts/test-coverage-rust.json"
  require_base_sha
  timeout --foreground 295s python scripts/coverage_forecast.py write-report-provenance \
    --base "$COVERAGE_BASE_SHA" \
    --report-name rust \
    --report "$rust_artifacts/test-coverage-rust.json" \
    --output "$rust_artifacts/coverage-provenance-rust.json" \
    --cargo-llvm-cov-version "$(cargo llvm-cov --version | awk '{print $2}')" \
    --rust-version "$(rustc --version | awk '{print $2}')"
  ci_phase_end
  ci_phase_begin rust-audit
  test "$(cargo audit --version)" = "cargo-audit-audit 0.22.2"
  (cd support/ptg2_scanner && cargo audit)
  ci_phase_end
  ci_phase_begin rust-release-build
  cargo build --release --bins --manifest-path support/ptg2_scanner/Cargo.toml
  ci_phase_end
  install_address_canon_wheel --release
  ci_phase_begin rust-native-tests
  HLTHPRT_PROVIDER_DIRECTORY_PROJECTION_NATIVE_TEST_BIN="$repository_root/support/ptg2_scanner/target/release/ptg2_scanner" \
  HLTHPRT_PROVIDER_DIRECTORY_PROJECTION_NATIVE_BIN="$repository_root/support/ptg2_scanner/target/release/ptg2_scanner" \
    timeout --foreground 295s python -m pytest -q \
      tests/test_provider_directory_projection_native_copy.py \
      tests/test_provider_directory_projection_native_cli_parity.py \
      tests/test_provider_directory_projection_native_copy_adversarial.py
  ci_phase_end
  run_rust_wheel_tests
  (
    local tmp
    tmp=$(mktemp -d)
    trap 'rm -rf -- "$tmp"' EXIT
    support/ptg2_scanner/target/release/ptg2_scanner --canon-version \
      | python -c 'import json,sys; payload=json.load(sys.stdin); assert payload["ruleset_version"] == 4, payload'
    printf "1\t(0,1)\t\\N\t123 Main St\tSuite 2\tAustin\tTX\t78701\tUS\n" > "$tmp/raw.copy"
    support/ptg2_scanner/target/release/ptg2_scanner \
      --address-canonicalize-copy "$tmp/raw.copy" "$tmp/keyed.copy"
    test -s "$tmp/keyed.copy"
  )
}

cleanup_container_image() {
  local status=$1 image=$2 remaining cleanup_status=0
  trap - EXIT
  remaining=$(docker image ls --quiet "$image") || cleanup_status=1
  if [ -n "$remaining" ]; then
    docker image rm "$image" >/dev/null || cleanup_status=1
  fi
  remaining=$(docker image ls --quiet "$image") || cleanup_status=1
  [ -z "$remaining" ] || cleanup_status=1
  if [ "$cleanup_status" != 0 ]; then
    printf 'Unable to verify CI image cleanup: %s\n' "$image" >&2
    [ "$status" -ne 0 ] || status=1
  fi
  ci_phase_end "$status"
  exit "$status"
}

run_container_package() {
  local source_commit=${SOURCE_SHA:?SOURCE_SHA must identify the public source}
  [ "$source_commit" = "$(git rev-parse HEAD)" ] || return 2
  local image="healthcare-mrf-api:ci-${GITHUB_RUN_ID:?}-${GITHUB_RUN_ATTEMPT:?}"
  local cleanup_command
  printf -v cleanup_command 'cleanup_container_image $? %q' "$image"
  trap "$cleanup_command" EXIT
  local build_args=(--build-arg "HLTHPRT_SOURCE_COMMIT=${source_commit}")
