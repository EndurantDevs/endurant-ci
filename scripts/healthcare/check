run_python_inference() (
  inference_root=$(mktemp -d "${RUNNER_TEMP:-/tmp}/healthcare-python-inference.XXXXXX")
  cleanup_python_inference() {
    local status=$?
    trap - EXIT
    if ! rm -rf -- "$inference_root"; then
      printf 'Unable to remove Python inference environment: %s\n' "$inference_root" >&2
      [ "$status" -ne 0 ] || status=1
    fi
    ci_phase_end "$status"
    exit "$status"
  }
  trap cleanup_python_inference EXIT
  ci_phase_begin python-inference-dependencies
  runtime_python=$(command -v python)
  uv --no-config venv --python "$runtime_python" --no-python-downloads "$inference_root/venv"
  uv --no-config pip sync --python "$inference_root/venv/bin/python" --require-hashes --only-binary=:all: \
    "$CI_ROOT/scripts/requirements-python-quality.lock"
  ci_phase_end
  local -a inference_targets=(
    api/billing_search_selector_contract.py
    api/billing_search_transport_contract.py
    api/mrf_discovery_catalog_manifest.py
    api/plan_pricing_state_scan_contract.py
    process/formulary_fhir/uhc_drug_parser_contract.py
    process/formulary_fhir/uhc_drug_transport_contract.py
    process/provider_directory_rooted_graph_source_contract.py
    process/provider_directory_rooted_graph_twin_admission_contract.py
    process/provider_directory_rooted_graph_twin_contract.py
    process/provider_directory_validated_publication_contract.py
    public_evidence/evidence_record_token_policy.py
  )
  local inference_target
  for inference_target in "${inference_targets[@]}"; do
    [[ -f "$inference_target" ]] || {
      printf 'Python inference target is missing: %s\n' "$inference_target" >&2
      return 2
    }
  done
  ci_phase_begin python-inference
  # Resolve real application dependencies without adding tools to the runtime.
  printf 'from aiohttp import client\nimport orjson\nclient.quality_probe_missing_member()\norjson.quality_probe_missing_member()\n' \
    > "$inference_root/quality_inference_probe.py"
  probe_status=0
  probe_output=$("$inference_root/venv/bin/ty" check --config-file /dev/null --python "$runtime_python" \
    --output-format concise --no-progress "$inference_root/quality_inference_probe.py") || probe_status=$?
  [[ "$probe_status" == 1 && "$probe_output" == *'unresolved-attribute'* \
    && "$probe_output" == *'Module `aiohttp.client` has no member `quality_probe_missing_member`'* \
    && "$probe_output" == *'Module `orjson` has no member `quality_probe_missing_member`'* ]] || {
    printf 'Python runtime dependency inference canary failed (status %s):\n%s\n' "$probe_status" "$probe_output" >&2
    return 2
  }
  "$inference_root/venv/bin/ruff" check --isolated --no-cache --ignore-noqa \
    --select ANN201,ANN202,ANN204,ANN205,ANN206 \
    --config lint.flake8-annotations.suppress-none-returning=false "${inference_targets[@]}"
  "$inference_root/venv/bin/ty" check --config-file /dev/null --python "$runtime_python" \
    --output-format concise --no-progress "${inference_targets[@]}"
  ci_phase_end
)

