#!/usr/bin/env bash
set -euo pipefail

repository_root=${SOURCE_ROOT:?SOURCE_ROOT must name the exact public checkout}
CI_ROOT=${CI_ROOT:?CI_ROOT must name the pinned public CI checkout}
cd "$repository_root"
export PYTHONPATH="$repository_root${PYTHONPATH:+:$PYTHONPATH}"

semgrep_image='returntocorp/semgrep-agent@sha256:50140e658095736c7f9d2c12c1e8a98b13f044b773dc79aa98e83b8117dbf096'

capacity_test_paths=${CAPACITY_TEST_PATHS:-$'tests/test_ptg2_capacity_evidence.py\ntests/test_ptg2_v3_bounded_readers.py\ntests/test_ptg2_v3_capacity_gate.py\ntests/test_ptg2_v3_capacity_gate_adversarial.py\ntests/test_ptg2_v3_capacity_resources.py'}
artifact_root=${CI_ARTIFACT_ROOT:-.}

artifact_path() {
  if [ "$artifact_root" = . ]; then
    printf '%s\n' "$1"
  else
    printf '%s/%s\n' "${artifact_root%/}" "$1"
  fi
}

usage() {
  cat >&2 <<'EOF'
usage: scripts/healthcare/check MODE [ARG]

MODE is one of:
  hygiene
  quality
  python-main 0|1|2|3
  capacity
  api-contract
  rust
  container-package
  security
  redis
  postgres core|provider-directory|provider-profile
EOF
  exit 2
}

prepare_python_environment() {
  if [ "${CI_DEPS_READY:-0}" = 1 ]; then
    return
  fi
  if [ "${CI_PYTHON_ENV_READY:-0}" = 1 ]; then
    return
  fi
  python_environment_root=$(mktemp -d "${RUNNER_TEMP:-/tmp}/healthcare-ci-python.XXXXXX")
  cleanup_python_environment() {
    local status=$?
    trap - EXIT
    if ! rm -rf -- "$python_environment_root"; then
      printf 'Unable to remove CI Python environment: %s\n' "$python_environment_root" >&2
      [ "$status" -ne 0 ] || status=1
    fi
    exit "$status"
  }
  trap cleanup_python_environment EXIT
  test "$(uv --no-config --version | awk '{print $2}')" = 0.12.12
  uv --no-config venv --python 3.14.7 --no-python-downloads "$python_environment_root/venv"
  export VIRTUAL_ENV="$python_environment_root/venv"
  export PATH="$VIRTUAL_ENV/bin:$PATH"
  unset PYTHONHOME || true
  export CI_PYTHON_ENV_READY=1
}

install_python_dependencies() {
  if [ "${CI_DEPS_READY:-0}" = 1 ]; then
    return
  fi
  prepare_python_environment
  "$CI_ROOT/scripts/healthcare/install_python_lock" "$@"
}

prepare_debug_rust_binaries() {
  if [ "${CI_RUST_BINARIES+x}" != x ]; then
    "$@"
    return
  fi

  local source_directory=$CI_RUST_BINARIES
  local target_directory="$repository_root/support/ptg2_scanner/target/debug"
  local binaries=(
    ptg2_scanner
    ptg2_provider_graph_v4
    raw_claim_check
    uhc_semantic_facts
  )
  local binary

  if [ -z "$source_directory" ] || [ ! -d "$source_directory" ] || [ -L "$source_directory" ]; then
    echo "CI_RUST_BINARIES must name a real directory" >&2
    return 2
  fi
  for binary in "${binaries[@]}"; do
    if [ ! -f "$source_directory/$binary" ] || [ -L "$source_directory/$binary" ]; then
      echo "invalid prebuilt Rust binary: $binary" >&2
      return 2
    fi
  done

  mkdir -p "$target_directory"
  for binary in "${binaries[@]}"; do
    install -m 0755 "$source_directory/$binary" "$target_directory/$binary"
  done
}

wait_for_service() {
  local service=$1
  local timeout_seconds=$2
  shift 2
  local deadline=$((SECONDS + timeout_seconds))
  until "$@" >/dev/null 2>&1; do
    if (( SECONDS >= deadline )); then
      echo "$service service was not ready within $timeout_seconds seconds" >&2
      return 1
    fi
    sleep 1
  done
}

require_base_sha() {
  if [[ ! "${COVERAGE_BASE_SHA:-}" =~ ^[0-9a-f]{40}$ ]]; then
    echo "COVERAGE_BASE_SHA must be an exact commit SHA" >&2
    exit 2
  fi
}

commit_message_policy() {
  if [ "${PR_NUMBER:-0}" != 0 ]; then
    python3 scripts/check_commit_messages.py --message="${SOURCE_PR_TITLE:?Authenticated PR title is required}"
  fi
  require_base_sha
  python3 scripts/check_commit_messages.py --range "$COVERAGE_BASE_SHA..HEAD"
}

run_hygiene() {
  commit_message_policy
  python3 tests/test_public_hygiene.py
  python3 scripts/ci/public_hygiene.py
}

run_quality() {
  commit_message_policy
  # Lint sync must never replace an already prepared application environment.
  unset CI_DEPS_READY CI_PYTHON_ENV_READY
  prepare_python_environment
  uv --no-config pip sync --python "$(command -v python)" --require-hashes --only-binary=:all: \
    "$CI_ROOT/scripts/requirements-python-quality.lock"
  ruff check --no-cache .
  python "$CI_ROOT/scripts/python_format.py" "$BASE_SHA"
  python -m compileall api process db public_evidence scripts main.py
  python scripts/coverage_reports.py --check
  python scripts/ci/request_time_external_call_guard.py
}

run_python_main() {
  local shard=${1:-}
  case "$shard" in 0|1|2|3) ;; *) usage ;; esac
  if [ "${CI_DEPS_READY:-0}" = 1 ]; then
    prepare_debug_rust_binaries cargo build --locked --bins --manifest-path support/ptg2_scanner/Cargo.toml
  else
    prepare_python_environment
    install_python_dependencies &
    local install_pid=$!
    prepare_debug_rust_binaries cargo build --locked --bins --manifest-path support/ptg2_scanner/Cargo.toml &
    local cargo_pid=$!
    wait "$install_pid"
    wait "$cargo_pid"
  fi

  mapfile -t capacity_tests <<< "$capacity_test_paths"
  local collection_args=()
  local test_path
  for test_path in "${capacity_tests[@]}"; do
    collection_args+=(--ignore "$test_path")
  done
  export COVERAGE_FILE=${COVERAGE_FILE:-$(artifact_path ".coverage.main.${shard}")}
  timeout --foreground 420s python -m pytest -q -n 1 --dist loadscope --durations=20 \
    -p scripts.ci.shard_pytest_nodeids --ci-shard-count 4 --ci-shard-index "$shard" \
    --cov-config=test-coverage.ini \
    --cov=api --cov=db --cov=process --cov=public_evidence --cov=service --cov=main \
    --cov-branch --cov-report= \
    "${collection_args[@]}"
  require_base_sha
  timeout --foreground 295s python scripts/coverage_forecast.py write-shard-provenance \
    --base "$COVERAGE_BASE_SHA" \
    --kind main \
    --shard "$shard" \
    --coverage "$COVERAGE_FILE" \
    --output "$(artifact_path ".coverage-provenance.main.${shard}.json")"
}

run_capacity() {
  install_python_dependencies
  mapfile -t capacity_tests <<< "$capacity_test_paths"
  export COVERAGE_FILE=${COVERAGE_FILE:-$(artifact_path .coverage.capacity)}
  timeout --foreground 295s python -m pytest -q -n 4 --dist worksteal --durations=20 \
    --cov-config=test-coverage.ini \
    --cov=api --cov=db --cov=process --cov=public_evidence --cov=service --cov=main \
    --cov-branch --cov-report= \
    "${capacity_tests[@]}"
  require_base_sha
  timeout --foreground 295s python scripts/coverage_forecast.py write-shard-provenance \
    --base "$COVERAGE_BASE_SHA" \
    --kind capacity \
    --shard capacity \
    --coverage "$COVERAGE_FILE" \
    --output "$(artifact_path .coverage-provenance.capacity.json)"
}


run_python_inference() (
  inference_root=$(mktemp -d "${RUNNER_TEMP:-/tmp}/healthcare-python-inference.XXXXXX")
  cleanup_python_inference() {
    local status=$?
    trap - EXIT
    if ! rm -rf -- "$inference_root"; then
      printf 'Unable to remove Python inference environment: %s\n' "$inference_root" >&2
      [ "$status" -ne 0 ] || status=1
    fi
    exit "$status"
  }
  trap cleanup_python_inference EXIT
  uv --no-config venv --python "$(command -v python)" --no-python-downloads "$inference_root/venv"
  uv --no-config pip sync --python "$inference_root/venv/bin/python" --require-hashes --only-binary=:all: \
    "$CI_ROOT/scripts/requirements-python-quality.lock"
  # Infer against the verified application dependencies, after the pinned lint packages.
  runtime_hook=$(python -c 'import site; print("import sys; sys.path.extend(" + repr(site.getsitepackages()) + ")")')
  probe_status=0
  probe_output=$(printf 'from aiohttp import client\nimport orjson\nclient.quality_probe_missing_member()\norjson.quality_probe_missing_member()\n' | \
    "$inference_root/venv/bin/pylint" --init-hook "$runtime_hook" --from-stdin quality_inference_probe.py) || probe_status=$?
  [[ "$probe_status" == 2 && "$probe_output" == *"'aiohttp.client' has no 'quality_probe_missing_member'"* \
    && "$probe_output" == *"'orjson' has no 'quality_probe_missing_member'"* ]] || {
    echo 'Pylint runtime dependency inference canary failed' >&2
    return 2
  }
  "$inference_root/venv/bin/pylint" --init-hook "$runtime_hook" \
    api/billing_search_selector_contract.py \
    api/billing_search_transport_contract.py \
    api/mrf_discovery_catalog_manifest.py \
    api/plan_pricing_state_scan_contract.py \
    process/fhir_request_failure_policy.py \
    process/formulary_fhir/uhc_drug_parser_contract.py \
    process/formulary_fhir/uhc_drug_transport_contract.py \
    process/provider_directory_rooted_graph_source_contract.py \
    process/provider_directory_rooted_graph_twin_admission_contract.py \
    process/provider_directory_rooted_graph_twin_contract.py \
    process/provider_directory_validated_publication_contract.py \
    public_evidence/evidence_record_token_policy.py
)

run_api_contract() {
  install_python_dependencies
  run_python_inference
  python scripts/smoke/provider_directory_runtime_contract.py
  python scripts/generate_provider_directory_support_docs.py --check
  timeout --foreground 295s python -m pytest -q \
    tests/test_openapi_spec.py \
    tests/test_formulary_fhir_openapi.py \
    tests/test_api_init_and_utils.py \
    tests/test_healthcheck.py
}

run_rust() {
  local rust_artifacts
  rust_artifacts=$(artifact_path coverage-artifacts/rust)
  install_python_dependencies
  cargo fmt --manifest-path support/ptg2_scanner/Cargo.toml -- --check
  cargo clippy --manifest-path support/ptg2_scanner/Cargo.toml --all-targets -- -D warnings
  mkdir -p "$rust_artifacts"
  test "$(cargo llvm-cov --version)" = "cargo-llvm-cov 0.8.7"
  LLVM_COV_FLAGS="${LLVM_COV_FLAGS:+$LLVM_COV_FLAGS }-compilation-dir=support/ptg2_scanner" \
    timeout --foreground 295s cargo llvm-cov --manifest-path support/ptg2_scanner/Cargo.toml \
    --all-targets --features python --remap-path-prefix --json \
    --output-path "$rust_artifacts/test-coverage-rust.json"
  require_base_sha
  timeout --foreground 295s python scripts/coverage_forecast.py write-report-provenance \
    --base "$COVERAGE_BASE_SHA" \
    --report-name rust \
    --report "$rust_artifacts/test-coverage-rust.json" \
    --output "$rust_artifacts/coverage-provenance-rust.json" \
    --cargo-llvm-cov-version "$(cargo llvm-cov --version | awk '{print $2}')" \
    --rust-version "$(rustc --version | awk '{print $2}')"
  test "$(cargo audit --version)" = "cargo-audit-audit 0.22.2"
  (cd support/ptg2_scanner && cargo audit)
  cargo build --release --bins --manifest-path support/ptg2_scanner/Cargo.toml
  HLTHPRT_PROVIDER_DIRECTORY_PROJECTION_NATIVE_TEST_BIN="$repository_root/support/ptg2_scanner/target/release/ptg2_scanner" \
  HLTHPRT_PROVIDER_DIRECTORY_PROJECTION_NATIVE_BIN="$repository_root/support/ptg2_scanner/target/release/ptg2_scanner" \
    timeout --foreground 295s python -m pytest -q \
      tests/test_provider_directory_projection_native_copy.py \
      tests/test_provider_directory_projection_native_cli_parity.py \
      tests/test_provider_directory_projection_native_copy_adversarial.py
  (
    local wheel_directory
    wheel_directory=$(mktemp -d "${RUNNER_TEMP:-/tmp}/healthcare-ptg2-wheel.XXXXXX")
    trap 'rm -rf -- "$wheel_directory"' EXIT
    cd support/ptg2_scanner
    python -m maturin build --release --features python-extension --out "$wheel_directory"
    shopt -s nullglob
    local wheels=("$wheel_directory"/*.whl)
    [ "${#wheels[@]}" -eq 1 ]
    if [ "$artifact_root" != . ]; then
      printf '%s  %s\n' \
        "$(sha256sum "${wheels[0]}" | awk '{print $1}')" \
        "$(basename "${wheels[0]}")" \
        > "$(artifact_path ptg2-address-canon-wheel.sha256)"
    fi
    uv --no-config pip install --python "$(command -v python)" --no-build --no-deps "${wheels[0]}"
    uv --no-config pip check --python "$(command -v python)"
  )
  timeout --foreground 295s python -m pytest -q tests/test_address_canon_pyo3.py
  (
    local tmp
    tmp=$(mktemp -d)
    trap 'rm -rf -- "$tmp"' EXIT
    support/ptg2_scanner/target/release/ptg2_scanner --canon-version \
      | python -c 'import json,sys; payload=json.load(sys.stdin); assert payload["ruleset_version"] == 4, payload'
    printf "1\t(0,1)\t\\N\t123 Main St\tSuite 2\tAustin\tTX\t78701\tUS\n" > "$tmp/raw.copy"
    support/ptg2_scanner/target/release/ptg2_scanner \
      --address-canonicalize-copy "$tmp/raw.copy" "$tmp/keyed.copy"
    test -s "$tmp/keyed.copy"
  )
}

cleanup_container_image() {
  local status=$1 image=$2 remaining cleanup_status=0
  trap - EXIT
  remaining=$(docker image ls --quiet "$image") || cleanup_status=1
  if [ -n "$remaining" ]; then
    docker image rm "$image" >/dev/null || cleanup_status=1
  fi
  remaining=$(docker image ls --quiet "$image") || cleanup_status=1
  [ -z "$remaining" ] || cleanup_status=1
  if [ "$cleanup_status" != 0 ]; then
    printf 'Unable to verify CI image cleanup: %s\n' "$image" >&2
    [ "$status" -ne 0 ] || status=1
  fi
  exit "$status"
}

run_container_package() {
  local source_commit=${SOURCE_SHA:?SOURCE_SHA must identify the public source}
  [ "$source_commit" = "$(git rev-parse HEAD)" ] || return 2
  local image="healthcare-mrf-api:ci-${GITHUB_RUN_ID:?}-${GITHUB_RUN_ATTEMPT:?}"
  local cleanup_command
  printf -v cleanup_command 'cleanup_container_image $? %q' "$image"
  trap "$cleanup_command" EXIT
  local build_args=(--build-arg "HLTHPRT_SOURCE_COMMIT=${source_commit}")
  local build_command=(docker build)
  if [[ "${PUBLIC_CI_EXPORT_IMAGE:-0}" == 1 ]]; then
    python3 "$CI_ROOT/scripts/source_image.py" prepare-engine
    build_command=(docker buildx build --provenance=mode=max --load)
    build_args+=(--label "org.endurantdevs.public-ci.repository=${GITHUB_REPOSITORY:?}"
                 --label "org.endurantdevs.public-ci.run=${GITHUB_RUN_ID:?}-${GITHUB_RUN_ATTEMPT:?}")
  fi
  "${build_command[@]}" \
    "${build_args[@]}" \
    --platform linux/amd64 \
    --tag "$image" \
    .
  local tested_image
  tested_image=$(docker image inspect --format '{{.Id}}' "$image")
  [[ "$tested_image" =~ ^sha256:[0-9a-f]{64}$ ]]
  if docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' \
    "$tested_image" \
    | grep -q '^HLTHPRT_SOURCE_COMMIT='; then
    exit 1
  fi
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$tested_image" \
    -ec '
      test "$(cat /opt/healthporta/build-identity/healthcare-source-commit)" = "$1"
      test "$(stat -c "%u:%g:%a:%h:%s" /opt/healthporta/build-identity/healthcare-source-commit)" = "0:0:444:1:41"
    ' sh "$source_commit"
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$tested_image" \
    -ec '
      test -x /opt/support/ptg2_scanner/target/release/ptg2_scanner
      test -x /opt/support/ptg2_scanner/target/release/ptg2_provider_graph_v4
      /opt/venv/bin/python -c "import ptg2_address_canon as m; assert hasattr(m, '\''intersect_sorted_u32'\''); assert hasattr(m, '\''ptg2_decode_u32_le'\'')"
      /opt/venv/bin/python -B -c "import public_evidence; import process.npi"
    '
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$tested_image" \
    -ec '
      set +e
      operation_output=$(env \
        -u HLTHPRT_FHIR_FORMULARY_REVIEWED_ACQUISITION_ENABLED \
        -u HLTHPRT_FHIR_FORMULARY_REVIEWED_PUBLICATION_ENABLED \
        /opt/venv/bin/python -B \
        /opt/scripts/smoke/formulary_fhir_reviewed_operator.py \
        acquire-twins --cutoff 2026-01-01T00:00:00Z 2>&1)
      operation_status=$?
      set -e
      test "$operation_status" -eq 1
      operation_last_line=$(printf "%s\n" "$operation_output" | tail -n 1)
      test "$operation_last_line" = '\''{"code":"disabled","status":"error"}'\''
    '
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$tested_image" \
    -ec '
      set +e
      operation_output=$(env \
        -u HLTHPRT_UHC_FORMULARY_ACQUISITION_ENABLED \
        -u HLTHPRT_UHC_FORMULARY_PUBLICATION_ENABLED \
        /opt/venv/bin/python -B \
        /opt/scripts/smoke/uhc_formulary_operator.py \
        acquire-admit \
        --raw-set-sha256 \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        2>&1)
      operation_status=$?
      set -e
      test "$operation_status" -eq 1
      operation_last_line=$(printf "%s\n" "$operation_output" | tail -n 1)
      test "$operation_last_line" = '\''{"code":"disabled","status":"error"}'\''
    '
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$tested_image" \
    -ec '
      set +e
      operation_output=$(env \
        -u HLTHPRT_PROVIDER_DIRECTORY_ROOTED_GRAPH_REGISTRATION_ENABLED \
        -u HLTHPRT_PROVIDER_DIRECTORY_ROOTED_GRAPH_ACQUISITION_ENABLED \
        -u HLTHPRT_PROVIDER_DIRECTORY_ROOTED_GRAPH_SINGLE_ROOT_ACQUISITION_ENABLED \
        -u HLTHPRT_PROVIDER_DIRECTORY_ROOTED_GRAPH_PUBLICATION_ENABLED \
        /opt/venv/bin/python -B \
        /opt/scripts/smoke/provider_directory_rooted_graph_operator.py \
        acquire-single-root \
        --operation-key \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        2>&1)
      operation_status=$?
      set -e
      test "$operation_status" -eq 1
      operation_last_line=$(printf "%s\n" "$operation_output" | tail -n 1)
      test "$operation_last_line" = '\''{"code":"disabled","status":"error"}'\''
    '
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$tested_image" \
    -ec '
      set +e
      operation_output=$(env \
        -u HLTHPRT_UHC_FLEX_PRACTITIONER_SINGLE_ROOT_ACQUISITION_ENABLED \
        /opt/venv/bin/python -B \
        /opt/scripts/smoke/uhc_flex_practitioner_operator.py \
        acquire-admit-single-root \
        --operation-key \
        aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa \
        --semantic-projection-as-of 2026-08-12 2>&1)
      operation_status=$?
      set -e
      test "$operation_status" -eq 1
      operation_last_line=$(printf "%s\n" "$operation_output" | tail -n 1)
      test "$operation_last_line" = '\''{"code":"disabled","status":"error"}'\''
    '
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$tested_image" \
    -ec '
      for operation in \
        sync-verified-state \
        abandon-expired-root \
        seal-terminal-root \
        seal-direct-v4-terminal-root \
        seal-direct-v5-http410-root; do
        set +e
        operation_output=$(env \
          -u HLTHPRT_PROVIDER_DIRECTORY_SUBSET_STATE_SYNC_ENABLED \
          -u HLTHPRT_PROVIDER_DIRECTORY_REVIEWED_SUBSET_ABANDONMENT_ENABLED \
          -u HLTHPRT_PROVIDER_DIRECTORY_REVIEWED_SUBSET_TERMINAL_DISPOSITION_ENABLED \
          -u HLTHPRT_PROVIDER_DIRECTORY_REVIEWED_SUBSET_DIRECT_V4_TERMINAL_DISPOSITION_ENABLED \
          -u HLTHPRT_PROVIDER_DIRECTORY_REVIEWED_SUBSET_DIRECT_V5_HTTP410_TERMINAL_DISPOSITION_ENABLED \
          /opt/venv/bin/python -B \
          /opt/scripts/smoke/provider_directory_fhir_reviewed_subset_state.py \
          "$operation" 2>&1)
        operation_status=$?
        set -e
        test "$operation_status" -eq 1
        test "$operation_output" = '\''{"code":"disabled","status":"error"}'\''
      done
    '
  docker run --rm --platform linux/amd64 \
    --entrypoint /bin/sh \
    "$tested_image" \
    -ec '
      set +e
      operation_output=$(env \
        -u HLTHPRT_PROVIDER_DIRECTORY_TERMINAL_ROOT_RETIREMENT_ENABLED \
        /opt/venv/bin/python -B \
        /opt/scripts/smoke/provider_directory_terminal_root_retirement.py \
        2>&1)
      operation_status=$?
      set -e
      test "$operation_status" -eq 1
      test "$operation_output" = '\''{"code":"disabled","status":"error"}'\''
    '
  local validation_path
  for validation_path in \
    scripts/smoke/provider_directory_runtime_contract.py \
    scripts/research/provider_directory_coverage_audit.py \
    scripts/research/provider_directory_fhir_harness.py \
    scripts/devops/ptg2_strict_v3_cutover_ready.py; do
    [ -f "$repository_root/$validation_path" ] || { printf 'Missing image validator: %s\n' "$validation_path" >&2; return 1; }
  done
  # Validators excluded from the image use exact-source read-only mounts; all
  # production modules and packaged operator commands come from the tested image.
  docker run --rm --platform linux/amd64 --network none --workdir /opt --entrypoint /opt/venv/bin/python \
    --mount "type=bind,source=$repository_root/scripts/smoke/provider_directory_runtime_contract.py,target=/opt/scripts/smoke/provider_directory_runtime_contract.py,readonly" \
    --mount "type=bind,source=$repository_root/scripts/research/provider_directory_coverage_audit.py,target=/opt/scripts/research/provider_directory_coverage_audit.py,readonly" \
    --mount "type=bind,source=$repository_root/scripts/research/provider_directory_fhir_harness.py,target=/opt/scripts/research/provider_directory_fhir_harness.py,readonly" \
    "$tested_image" scripts/smoke/provider_directory_runtime_contract.py
  docker run --rm --platform linux/amd64 --network none --entrypoint /bin/sh "$tested_image" -ec '
    test -f /opt/alembic/versions/20260712120000_ptg2_v3_shared_schema.py
    test -s /opt/healthporta/build-identity/healthcare-source-commit
    test -f /opt/alembic/versions/20260810110000_ptg_wave_receipt_authority.py
    test -f /opt/process/ptg_wave_receipt_process_authority.py
    grep -Fq RECEIPT_AUTHORITY_ROLE_ENV /opt/process/ptg_wave_receipt_process_authority.py
  '
  docker run --rm --platform linux/amd64 --network none --workdir /opt --entrypoint /opt/venv/bin/python \
    --mount "type=bind,source=$repository_root/scripts/devops/ptg2_strict_v3_cutover_ready.py,target=/run/healthporta-validation/cutover-ready.py,readonly" \
