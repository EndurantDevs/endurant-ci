run_scoped_archive_postgres() (
  scoped_archive_database=$1
  scoped_archive_drain_file=
  local variable=$2 url_prefix=$3
  shift 3
  HLTHPRT_DB_HOST=127.0.0.1 HLTHPRT_DB_PORT=5440
  export HLTHPRT_DB_DATABASE="$scoped_archive_database"
  export HLTHPRT_DB_DATABASE_OVERRIDE="$scoped_archive_database"
  cleanup_scoped_archive() {
    local status=$?
    trap - EXIT
    if [[ -n "$scoped_archive_drain_file" &&
          (! -f "$scoped_archive_drain_file" || "$(< "$scoped_archive_drain_file")" != drained) ]]; then
      printf 'Installed test processes did not drain; retained disposable database: %s\n' \
        "$scoped_archive_database" >&2
      [ "$status" -ne 0 ] || status=1
    elif ! PGDATABASE=postgres drop_test_database "$scoped_archive_database"; then
      [ "$status" -ne 0 ] || status=1
    fi
    if [[ -n "$scoped_archive_drain_file" ]] && ! rm -f -- "$scoped_archive_drain_file"; then
      [ "$status" -ne 0 ] || status=1
    fi
    exit "$status"
  }
  trap cleanup_scoped_archive EXIT
  create_test_database "$scoped_archive_database"
  export "$variable=$url_prefix/$scoped_archive_database"
  export PGHOST=127.0.0.1 PGPORT=5440 PGUSER="$HLTHPRT_DB_USER"
  export PGPASSWORD="$HLTHPRT_DB_PASSWORD" PGDATABASE="$scoped_archive_database"
