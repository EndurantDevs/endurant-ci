assert 0 < len(document) <= 16 * 1024 * 1024, "Native registry report is missing or oversized"
root = ET.fromstring(document)
assert root.tag in ("testsuite", "testsuites"), "Native registry report has an invalid root"
suites = [root] if root.tag == "testsuite" else list(root.findall("testsuite"))
assert suites, "Native registry report has no suites"
