    actual = [(case.attrib.get("classname", ""), case.attrib.get("name", "")) for case in cases]
    assert expected and len(expected) == len(set(expected)), "Native registry selection is empty or duplicated"
    assert len(actual) == len(expected) and set(actual) == set(expected), "Native registry report differs from its exact shard selection"
else:
    required = {path.removesuffix(".py").replace("/", ".") for path in sys.argv[3:]}
    assert required, "Native registry report has no required families"
    class_names = {case.attrib.get("classname", "") for case in cases}
    assert all(any(name == module or name.startswith(module + ".") for name in class_names) for module in required), "Native registry report omits a required family"
PY
)

