run_owned_provider_directory_postgres() (
  local prefix=$1 variable=$2
  shift 2
  # EXIT cleanup must retain the identifier after errexit unwinds function locals.
  owned_directory_database="${prefix}_$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
  cleanup_owned_database() {
    local status=$?
    trap - EXIT
    if ! PGDATABASE=postgres drop_test_database "$owned_directory_database"; then
      [ "$status" -ne 0 ] || status=1
    fi
    exit "$status"
  }
  trap cleanup_owned_database EXIT
  create_test_database "$owned_directory_database"
  local dsn="postgresql+asyncpg://${HLTHPRT_DB_USER}:${HLTHPRT_DB_PASSWORD}@${HLTHPRT_DB_HOST}:${HLTHPRT_DB_PORT}/${owned_directory_database}"
  env -u DB_SCHEMA -u HLTHPRT_DB_DATABASE_OVERRIDE \
    "$variable=$dsn" HLTHPRT_DB_DATABASE="$owned_directory_database" \
    timeout --foreground 295s python -m pytest -q "$@"
)

run_available_cms_postgres() (
  local database_scope=$1 test_path
  shift
  local selected=()
  for test_path in "$@"; do
    if [ -f "$repository_root/${test_path%%::*}" ]; then
      selected+=("$test_path")
    fi
  done
  [ "${#selected[@]}" -gt 0 ] || exit 0
  case "$database_scope" in
    owned)
      artifact_root=
      cleanup_cms_artifacts() {
        local status=$?
        trap - EXIT
        if [ -n "$artifact_root" ] && ! rmdir "$artifact_root"; then
          [ "$status" -ne 0 ] || status=1
        fi
        exit "$status"
      }
      trap cleanup_cms_artifacts EXIT
      artifact_root=$(mktemp -d "${RUNNER_TEMP:-/tmp}/cms-npd-admission.XXXXXX")
      export HLTHPRT_CMS_NPD_ADMISSION_TEST_ARTIFACT_ROOT="$artifact_root"
      run_owned_provider_directory_postgres hc_cms_admission_test HLTHPRT_CMS_NPD_ADMISSION_TEST_DSN \
        "${selected[@]}"
      ;;
    runtime)
      env -u DB_SCHEMA -u HLTHPRT_DB_DATABASE_OVERRIDE \
        timeout --foreground 295s python -m pytest -q "${selected[@]}"
      ;;
    *) exit 2 ;;
  esac
)

