install_address_canon_wheel() (
  local wheel_directory cleanup_command
  wheel_directory=$(mktemp -d "${RUNNER_TEMP:-/tmp}/healthcare-ptg2-wheel.XXXXXX")
  printf -v cleanup_command 'ci_phase_end "$?"; rm -rf -- %q' "$wheel_directory"
  trap "$cleanup_command" EXIT
  cd support/ptg2_scanner
  ci_phase_begin rust-wheel-build
  python -m maturin build "$@" --locked --features python-extension --out "$wheel_directory"
  shopt -s nullglob
  local wheels=("$wheel_directory"/*.whl)
  [ "${#wheels[@]}" -eq 1 ]
  if [ "$artifact_root" != . ]; then
    printf '%s  %s\n' \
      "$(sha256sum "${wheels[0]}" | awk '{print $1}')" \
      "$(basename "${wheels[0]}")" \
      > "$(artifact_path ptg2-address-canon-wheel.sha256)"
  fi
  ci_phase_end
  ci_phase_begin rust-wheel-install
  uv --no-config pip install --python "$(command -v python)" --no-build --no-deps --reinstall "${wheels[0]}"
  uv --no-config pip check --python "$(command -v python)"
  ci_phase_end
)

run_rust_wheel_tests() {
  ci_phase_begin rust-wheel-tests
  local wheel_tests=(tests/test_address_canon_pyo3.py)
  if [ -f "$repository_root/tests/test_custom_import_scalar_digest.py" ]; then
    python - <<'PY'
import inspect
import ptg2_address_canon

encoder = getattr(ptg2_address_canon, "custom_import_scalar_frames_v1", None)
if not callable(encoder) or not inspect.isbuiltin(encoder):
    raise SystemExit("installed wheel does not provide compiled scalar framing")
PY
    wheel_tests+=(tests/test_custom_import_scalar_digest.py)
