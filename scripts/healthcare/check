run_postgres() {
  local shard=${1:-}
  case "$shard" in
    core|provider-directory|provider-profile|core-services|core-imports|core-ptg|registry-[0-7]|directory-source|directory-storage|directory-address|profile-storage|profile-publication) ;;
    *) usage ;;
  esac
  if [ "${CI_DEPS_READY:-0}" = 1 ]; then
    prepare_debug_rust_binaries cargo build --manifest-path support/ptg2_scanner/Cargo.toml
  else
    prepare_python_environment
    { trap 'ci_phase_end "$?"' EXIT; install_python_dependencies; } &
    local install_pid=$!
    { trap 'ci_phase_end "$?"' EXIT; prepare_debug_rust_binaries cargo build --manifest-path support/ptg2_scanner/Cargo.toml; } &
    local cargo_pid=$!
    wait "$install_pid"
    wait "$cargo_pid"
  fi

  export HLTHPRT_DB_DRIVER=${HLTHPRT_DB_DRIVER:-asyncpg}
  export HLTHPRT_DB_HOST=${HLTHPRT_DB_HOST:-127.0.0.1}
  export HLTHPRT_DB_PORT=${HLTHPRT_DB_PORT:-5432}
  export HLTHPRT_DB_USER=${HLTHPRT_DB_USER:-postgres}
  export HLTHPRT_DB_PASSWORD=${HLTHPRT_DB_PASSWORD:-postgres}
  export HLTHPRT_DB_DATABASE=${HLTHPRT_DB_DATABASE:-ptg2_v3_lifecycle_test_ci_runner}
  export HLTHPRT_DB_SCHEMA=${HLTHPRT_DB_SCHEMA:-mrf}
  export DB_SCHEMA=${DB_SCHEMA:-mrf}
  export HLTHPRT_REDIS_ADDRESS=${HLTHPRT_REDIS_ADDRESS:-redis://127.0.0.1:6379}
  export PYTEST_ADDOPTS=${PYTEST_ADDOPTS:-'--cov-config=test-coverage.ini --cov=api --cov=db --cov=process --cov=public_evidence --cov=service --cov=main --cov-branch --cov-report= --cov-append'}
  export COVERAGE_FILE=${COVERAGE_FILE:-$(artifact_path ".coverage.postgres.${shard}")}

  ci_phase_begin postgres-prepare
  wait_for_service PostgreSQL 30 \
    pg_isready \
      --host "$HLTHPRT_DB_HOST" \
      --port "$HLTHPRT_DB_PORT" \
      --username "$HLTHPRT_DB_USER" \
      --dbname "$HLTHPRT_DB_DATABASE" \
      --timeout=1
  prepare_postgres
  ci_phase_end
  if [[ "$shard" = core ]]; then
    run_network_registry_postgres
  elif [[ "$shard" = registry-* ]]; then
    run_network_registry_postgres "${shard#registry-}"
  fi
  if [[ "$shard" = directory-source || "$shard" = provider-directory ]]; then
    install_address_canon_wheel
  fi
  ci_phase_begin postgres-tests
  local dsn="postgresql://${HLTHPRT_DB_USER}:${HLTHPRT_DB_PASSWORD}@${HLTHPRT_DB_HOST}:${HLTHPRT_DB_PORT}/${HLTHPRT_DB_DATABASE}"
  case "$shard" in
    core-*) run_core_postgres "$dsn" "$shard" ;;
    directory-*) run_provider_directory_postgres "$dsn" "$shard" ;;
    profile-*) run_provider_profile_postgres "$dsn" "$shard" ;;
    core) run_core_postgres "$dsn" ;;
    provider-directory) run_provider_directory_postgres "$dsn" ;;
    provider-profile) run_provider_profile_postgres "$dsn" ;;
  esac
  ci_phase_end

  require_base_sha
  timeout --foreground 295s python scripts/coverage_forecast.py write-shard-provenance \
    --base "$COVERAGE_BASE_SHA" \
    --kind postgres \
    --shard "$shard" \
    --coverage "$COVERAGE_FILE" \
    --output "$(artifact_path ".coverage-provenance.postgres.${shard}.json")"
}

case "${1:-}" in
  hygiene) [ "$#" -eq 1 ] || usage; run_hygiene ;;
  quality) [ "$#" -eq 1 ] || usage; run_quality ;;
  python-main) [ "$#" -eq 2 ] || usage; run_python_main "$2" ;;
  capacity) [ "$#" -eq 1 ] || usage; run_capacity ;;
  api-contract) [ "$#" -eq 1 ] || usage; run_api_contract ;;
  rust) [ "$#" -eq 1 ] || usage; run_rust ;;
  container-package) [ "$#" -eq 1 ] || usage; run_container_package ;;
  security) [ "$#" -eq 1 ] || usage; run_security ;;
  redis) [ "$#" -eq 1 ] || usage; run_redis ;;
  postgres) [ "$#" -eq 2 ] || usage; run_postgres "$2" ;;
  *) usage ;;
esac
