  unset CI_DEPS_READY CI_PYTHON_ENV_READY
  ci_phase_begin python-quality-dependencies
  prepare_python_environment
  uv --no-config pip sync --python "$(command -v python)" --require-hashes --only-binary=:all: \
    "$CI_ROOT/scripts/requirements-python-quality.lock"
