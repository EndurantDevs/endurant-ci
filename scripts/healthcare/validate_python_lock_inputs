#!/usr/bin/env python3
"""Fail when the exact Python lock no longer matches its recursive inputs."""

from __future__ import annotations

import hashlib
import os
import re
import sys
from pathlib import Path

repository_root = (
    Path(sys.argv[1]).resolve()
    if len(sys.argv) == 2
    else Path(os.environ["SOURCE_ROOT"]).resolve()
)
input_names = ("requirements.txt", "requirements-dev.txt", "requirements-ci.in")
ci_inputs = Path(__file__).resolve().parent
target = "# Target: CPython 3.14.7 (Linux x86_64)"
resolver = "# Resolver: uv 0.12.17"
required_packages = {"pip-audit": "2.10.1", "pip": "26.2.1"}
hash_line = re.compile(r"    --hash=sha256:[0-9a-f]{64}(?: \\)?$")
lock_path = repository_root / "requirements-ci.lock"
if not lock_path.is_file():
    raise SystemExit("requirements-ci.lock is missing from the source checkout")
lock_text = lock_path.read_text(encoding="utf-8")


def input_digest(name: str) -> str:
    root = ci_inputs if name == "requirements-ci.in" else repository_root
    return hashlib.sha256((root / name).read_bytes()).hexdigest()


expected = [f"# Input: {name} ({input_digest(name)})" for name in input_names]
recorded = [line for line in lock_text.splitlines() if line.startswith("# Input:")]
header = [
    "# Generated by scripts/healthcare/compile_python_lock.",
    *expected,
    target,
    resolver,
    "--only-binary :all:",
]
if lock_text.splitlines()[: len(header)] != header or recorded != expected:
    raise SystemExit(
        "requirements-ci.lock does not match its recursive inputs; "
        "regenerate it with scripts/healthcare/compile_python_lock"
    )


def package_name(line: str) -> str | None:
    if not line.endswith(" \\"):
        return None
    match = re.fullmatch(r"([A-Za-z0-9_.-]+)==[^\s;\\]+(?:\s*;\s*.+)?", line[:-2])
    return None if match is None else re.sub(r"[-_.]+", "-", match.group(1)).lower()


def validate_lock_body(lines: list[str]) -> None:
    names: set[str] = set()
    active_entry = False
    has_hash = False
    needs_hash = False
    for line in lines:
        if not line:
            if needs_hash:
                raise SystemExit("requirements-ci.lock has an unfinished continuation")
            continue
        name = package_name(line)
        if name is not None:
            if active_entry and not has_hash:
                raise SystemExit(
                    "requirements-ci.lock has an unhashed distribution entry"
                )
            if needs_hash:
                raise SystemExit("requirements-ci.lock has an unfinished continuation")
            if name in names:
                raise SystemExit(
                    "requirements-ci.lock has a duplicate distribution entry"
                )
            names.add(name)
            active_entry = True
            has_hash = False
            needs_hash = True
            continue
        if hash_line.fullmatch(line) is not None and active_entry and needs_hash:
            has_hash = True
            needs_hash = line.endswith(" \\")
            continue
        raise SystemExit("requirements-ci.lock contains unsupported content")
    if not active_entry or not has_hash:
        raise SystemExit("requirements-ci.lock must contain hash-locked distributions")
    if needs_hash:
        raise SystemExit("requirements-ci.lock has an unfinished continuation")


validate_lock_body(lock_text.splitlines()[len(header) :])

for package, version in required_packages.items():
    entry = re.compile(
        rf"^{re.escape(package)}=={re.escape(version)} \\\n"
        r"(?:    --hash=sha256:[0-9a-f]{64}(?: \\\n|\n))+",
        re.MULTILINE,
    )
    if not entry.search(lock_text):
        raise SystemExit(
            f"requirements-ci.lock must retain the hash-locked {package}=={version} entry"
        )
