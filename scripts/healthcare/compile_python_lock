#!/usr/bin/env bash
input_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source_root=${SOURCE_ROOT:?SOURCE_ROOT must identify the public source checkout}
cd "$input_root"
set -euo pipefail
unset PYTHONPATH || true

readonly UV_VERSION=0.12.17
readonly PYTHON_VERSION=3.14.7
test "$(uv --no-config --version | awk '{print $2}')" = "$UV_VERSION"
python_bin=$(uv --no-config python find "$PYTHON_VERSION")
test "$("$python_bin" -I -c 'import platform; print(platform.python_version())')" = "$PYTHON_VERSION"

temporary_directory=$(mktemp -d)
candidate_lock=$(mktemp "$source_root/requirements-ci.lock.candidate.XXXXXX")
trap 'rm -rf -- "$temporary_directory"; rm -f -- "$candidate_lock"' EXIT
input_names=(requirements.txt requirements-dev.txt requirements-ci.in)
mkdir "$temporary_directory/inputs"

hash_files() {
  local directory=$1
  shift
  (cd "$directory" && "$python_bin" -I - "$@" <<'PY'
import hashlib
from pathlib import Path
import sys

for name in sys.argv[1:]:
    print(f"{hashlib.sha256(Path(name).read_bytes()).hexdigest()}  {name}")
PY
  )
}

input_hashes() {
  hash_files "$source_root" requirements.txt requirements-dev.txt
  hash_files "$input_root" requirements-ci.in
}

input_hashes > "$temporary_directory/input-sha256.before"
cp -- "$source_root/requirements.txt" "$source_root/requirements-dev.txt" requirements-ci.in "$temporary_directory/inputs/"
hash_files "$temporary_directory/inputs" "${input_names[@]}" > "$temporary_directory/input-sha256.snapshot"
cmp "$temporary_directory/input-sha256.before" "$temporary_directory/input-sha256.snapshot"

uv --no-config pip compile "$temporary_directory/inputs/requirements-ci.in" \
  --python "$python_bin" \
  --python-version "$PYTHON_VERSION" \
  --python-platform x86_64-unknown-linux-gnu \
  --find-links https://github.com/dnikolayev/pytest-boorst/releases/download/v0.1.0a4/wheels.html \
  --generate-hashes \
  --only-binary :all: \
  --emit-build-options \
  --no-annotate \
  --no-header \
  --no-python-downloads \
  --output-file "$candidate_lock" \
  --quiet

"$python_bin" -I - "$temporary_directory/inputs" "$candidate_lock" "$UV_VERSION" <<'PY'
import hashlib
from pathlib import Path
import re
import sys


inputs = Path(sys.argv[1])
lock = Path(sys.argv[2])
uv_version = sys.argv[3]
body = lock.read_text(encoding="utf-8")
versions = {
    re.sub(r"[-_.]+", "-", match.group(1)).lower(): match.group(2)
    for match in re.finditer(r"^([A-Za-z0-9_.-]+)==([^\s;\\]+)", body, re.M)
}
if versions.get("pip-audit") != "2.10.1":
    raise SystemExit("selected lock must contain pip-audit==2.10.1")
if versions.get("pip") != "26.2.1":
    raise SystemExit("pip-audit must retain its locked pip==26.2.1 dependency")
# uv does not emit hashes for this release's flat wheel index.
wheel_hashes = (
    "265dd4a0e899520975c434c267d8c2ae2d930c0e16c9e59c796f0d46ea26f5a3",
    "8180a4071d493ed93a0138e546657e8e87dc0047ce9d738e9e1083554441d9bc",
    "dabd6bbf2941dd1ee6ff2984e3d2fdbd9a8b14634afee91229121c24c46892ef",
    "f118fe02876eed998c4a2d038d66bf7456cfdc83c8ab672c29e7acfa13abf890",
)
lines = body.splitlines(keepends=True)
entries = [index for index, line in enumerate(lines)
           if re.match(r"(?i)^pytest[-_.]boorst(?:[= \t]|$)", line)]
if len(entries) != 1 or versions.get("pytest-boorst") != "0.1.0a4":
    raise SystemExit("selected lock must contain exactly pytest-boorst==0.1.0a4")
start = entries[0]
end = start + 1
while end < len(lines) and lines[end].startswith((" ", "\t")):
    end += 1
entry = lines[start:end]
if entry != ["pytest-boorst==0.1.0a4\n"]:
    hashes = [re.fullmatch(r"    --hash=sha256:([a-f0-9]{64})(?: \\\n|\n)", line)
              for line in entry[1:]]
    if (entry[0] != "pytest-boorst==0.1.0a4 \\\n"
            or not all(hashes)
            or sorted(match.group(1) for match in hashes) != sorted(wheel_hashes)
            or any(not line.endswith(" \\\n") for line in entry[1:-1])
            or entry[-1].endswith(" \\\n")):
        raise SystemExit("unexpected pytest-boorst release entry or wheel hashes")
replacement = "pytest-boorst==0.1.0a4 \\\n" + " \\\n".join(
    "    --hash=sha256:" + digest for digest in wheel_hashes
) + "\n"
body = "".join(lines[:start]) + replacement + "".join(lines[end:])
header = [
    "# Generated by scripts/healthcare/compile_python_lock.",
    *(
        f"# Input: {name} ({hashlib.sha256((inputs / name).read_bytes()).hexdigest()})"
        for name in ("requirements.txt", "requirements-dev.txt", "requirements-ci.in")
    ),
    "# Target: CPython 3.14.7 (Linux x86_64)",
    f"# Resolver: uv {uv_version}",
]
lock.write_text("\n".join(header) + "\n" + body, encoding="utf-8")
PY

uv --no-config venv --python "$python_bin" --no-python-downloads "$temporary_directory/venv" >/dev/null
uv --no-config pip install \
  --dry-run \
  --python "$temporary_directory/venv/bin/python" \
  --python-version "$PYTHON_VERSION" \
  --python-platform x86_64-unknown-linux-gnu \
  --find-links https://github.com/dnikolayev/pytest-boorst/releases/download/v0.1.0a4/wheels.html \
  --only-binary :all: \
  --require-hashes \
  -r "$candidate_lock"

input_hashes > "$temporary_directory/input-sha256.after"
if ! cmp -s \
  "$temporary_directory/input-sha256.before" \
  "$temporary_directory/input-sha256.after"; then
  echo "Python requirement inputs changed during lock generation" >&2
  exit 1
fi
mv -- "$candidate_lock" "$source_root/requirements-ci.lock"
hash_files "$source_root" requirements-ci.lock
